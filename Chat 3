--[[
    YOGIMINI V2.1 | FUSE BOT FIX
    Basierend auf Bild 1000053075.jpg
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V2.1 | Fuse Bot",
   LoadingTitle = "Fusion Machine Logic...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false}
})

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local fusing = false

-- Hilfsfunktion: Drückt einen Button egal wo er ist
local function pressButton(btn)
    if btn and btn:IsA("GuiButton") then
        -- Simuliert einen Klick direkt über die Roblox-Events
        local events = {"MouseButton1Click", "MouseButton1Down", "Activated"}
        for _, event in ipairs(events) do
            for _, connection in ipairs(getconnections(btn[event])) do
                connection:Fire()
            end
        end
    end
end

local function doFuse()
    local gui = player.PlayerGui:FindFirstChild("Fusion", true) or player.PlayerGui:FindFirstChild("FusionMachine", true)
    if not gui then return end

    -- 1. Slots füllen
    -- Wir suchen nach den Brainrots in deinem Inventar-UI
    -- Das Inventar muss dafür offen oder im Hintergrund geladen sein
    local selected = 0
    for _, v in ipairs(player.PlayerGui:GetDescendants()) do
        if v:IsA("TextLabel") and v.Text:upper():find("GODLY") then
            local itemButton = v:FindFirstAncestorWhichIsA("GuiButton")
            if itemButton then
                pressButton(itemButton)
                selected = selected + 1
                task.wait(0.2)
            end
        end
        if selected >= 3 then break end
    end

    -- 2. "Fuse!" Button drücken (Referenz Bild 1000053075.jpg)
    if selected >= 3 then
        for _, v in ipairs(gui:GetDescendants()) do
            if v:IsA("TextButton") and (v.Text == "Fuse!" or v.Name == "Fuse") then
                pressButton(v)
                break
            end
        end
    end
end

-- // UI //
local MainTab = Window:CreateTab("Automation", 4483362458)

MainTab:CreateToggle({
   Name = "AUTO FUSE START",
   CurrentValue = false,
   Callback = function(Value)
      fusing = Value
      task.spawn(function()
          while fusing do
              -- Wenn kein Timer da ist, versuchen wir zu fusen
              local hasTimer = false
              for _, v in ipairs(player.PlayerGui:GetDescendants()) do
                  if v:IsA("TextLabel") and v.Visible and v.Text:find(":") then
                      hasTimer = true
                      break
                  end
              end

              if not hasTimer then
                  doFuse()
                  -- Falls nach dem Fusen ein "Claim" Button erscheint
                  task.wait(1)
                  for _, v in ipairs(player.PlayerGui:GetDescendants()) do
                      if v:IsA("TextButton") and v.Text:lower():find("claim") then
                          pressButton(v)
                      end
                  end
              end
              task.wait(10) -- Alle 10 Sek checken
          end
      end)
   end,
})
