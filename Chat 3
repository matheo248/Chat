--[[
    YOGIMINI V2.0 | THE FUSE-BOT
    Ablauf: TP -> Öffnen -> 3x Godly -> Fuse -> Warten -> Repeat
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V2.0 | Fuse Bot",
   LoadingTitle = "Loading Fuse-Sequence...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false}
})

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local vim = game:GetService("VirtualInputManager")
local fusing = false

-- // HILFSFUNKTIONEN //

-- Findet die Maschine auf der Map
local function getFuseMachine()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name:lower():find("fuse") and (obj:IsA("Model") or obj:IsA("BasePart")) then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then return obj, prompt end
        end
    end
    return nil
end

-- Simuliert einen Klick auf ein UI-Element (Knopf)
local function clickButton(button)
    if button and button.Visible then
        local pos = button.AbsolutePosition
        local size = button.AbsoluteSize
        -- Klickt in die Mitte des Buttons
        vim:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 50, 0, true, game, 0)
        task.wait(0.1)
        vim:SendMouseButtonEvent(pos.X + size.X/2, pos.Y + size.Y/2 + 50, 0, false, game, 0)
    end
end

-- // HAUPT-LOGIK //
local function fuseSequence()
    local machine, prompt = getFuseMachine()
    if not machine then return end

    -- 1. TP zur Maschine
    player.Character.HumanoidRootPart.CFrame = (machine.PrimaryPart or machine).CFrame * CFrame.new(0, 0, -3)
    task.wait(0.5)

    -- 2. "E" drücken um UI zu öffnen
    fireproximityprompt(prompt)
    task.wait(1)

    -- 3. In der UI 3 Godlys auswählen
    -- Wir suchen in der PlayerGui nach den Items
    local count = 0
    for _, item in ipairs(player.PlayerGui:GetDescendants()) do
        if item:IsA("TextLabel") and item.Text:upper():find("GODLY") then
            local clickable = item:FindFirstAncestorWhichIsA("ImageButton") or item:FindFirstAncestorWhichIsA("TextButton")
            if clickable then
                clickButton(clickable)
                count = count + 1
                task.wait(0.3)
            end
        end
        if count >= 3 then break end
    end

    -- 4. Den "VIEWS" Knopf drücken
    if count >= 3 then
        for _, btn in ipairs(player.PlayerGui:GetDescendants()) do
            if btn:IsA("TextButton") and btn.Text:lower():find("views") then
                clickButton(btn)
                break
            end
        end
    end
end

-- // UI //
local MainTab = Window:CreateTab("Automation", 4483362458)

MainTab:CreateToggle({
   Name = "AUTO FUSE START",
   CurrentValue = false,
   Callback = function(Value)
      fusing = Value
      
      task.spawn(function()
          while fusing do
              -- Sequenz starten
              fuseSequence()
              
              -- Warten bis Cooldown weg ist (20 Min Check)
              -- Wir prüfen alle 5 Sekunden, ob ein "Timer" Label noch existiert
              local timerActive = true
              local startTime = tick()
              
              while timerActive and fusing do
                  timerActive = false
                  -- Sucht nach einem Text der ":" enthält (typisch für Timer wie 19:59)
                  for _, label in ipairs(player.PlayerGui:GetDescendants()) do
                      if label:IsA("TextLabel") and label.Visible and string.find(label.Text, ":") then
                          timerActive = true
                          break
                      end
                  end
                  
                  -- Sicherheits-Timeout: Wenn nach 21 Min immer noch Timer da ist, brechen wir ab
                  if tick() - startTime > 1260 then break end 
                  
                  task.wait(5)
              end
              
              -- Claimen (falls ein Button "Claim" erscheint)
              for _, btn in ipairs(player.PlayerGui:GetDescendants()) do
                  if btn:IsA("TextButton") and btn.Text:lower():find("claim") then
                      clickButton(btn)
                      task.wait(1)
                  end
              end
              
              task.wait(2)
          end
      end)
   end,
})
