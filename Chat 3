local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V2.5 | Anti-Base",
   LoadingTitle = "Securing Perimeter...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- // TARGET LOGIK MIT ORDNER-SPERRE //
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local text = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(text, rarity) then
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model and not Players:GetPlayerFromCharacter(model) then
                        
                        -- 1. ORDNER-CHECK (Der ultimative Base-Killer)
                        local fullName = model:GetFullName():lower()
                        -- Wenn das Ziel in einem "Plot", "Base", "House" oder "Player" Ordner liegt -> BLOCK
                        if fullName:find("plot") or fullName:find("base") or fullName:find("house") or fullName:find("player") then
                            continue 
                        end

                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then
                            -- 2. GRÖSSEN-CHECK (Knöpfe am Boden ignorieren)
                            if hrp.Size.Y < 1.3 then continue end
                            
                            -- 3. TEXT-CHECK (Keine Shop-Schilder)
                            if text:lower():find("spawn") or text:lower():find("only") then continue end

                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- TP ZUM NPC
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2.5)
                      task.wait(0.35)
                      
                      -- INTERAKTION (E hämmern)
                      local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                      local endTime = tick() + 0.8
                      while tick() < endTime and farming do
                          if prompt then fireproximityprompt(prompt) end
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.1)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      end
                      
                      -- SOFORTIGER RÜCKFLUG
                      task.wait(0.1)
                      if basePos then
                          player.Character.HumanoidRootPart.CFrame = basePos
                      end
                      task.wait(0.8)
                  end
                  task.wait(0.1)
              end
          end)
      end
   end,
})

-- Toggles
local list = {"GODLY", "CELESTIAL", "DIVINE", "ADMIN", "EXCLUSIVE", "ETERNAL", "OG"}
for _, r in ipairs(list) do
    FarmTab:CreateToggle({
       Name = "Collect " .. r,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[r] = Value end,
    })
end
