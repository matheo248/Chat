--[[
    YOGIMINI V1.0 | AUTO-FUSE SYSTEM
    Fokus: 3x Godly -> Wait -> Claim -> Repeat
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.0 | Fuse Master",
   LoadingTitle = "Initializing Fuse Logic...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false}
})

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = game:GetService("Players").LocalPlayer
local fusing = false

-- // FUNKTIONEN //

-- Findet Godlys in deinem Inventar (muss an das Spiel-Backend angepasst sein)
local function getGodlys()
    local godlys = {}
    -- Hier suchen wir in deinem Inventar-Ordner (meistens in ReplicatedStorage oder PlayerGui)
    -- Da ich die genaue Inventar-Struktur nicht sehe, nutzen wir einen Platzhalter-Check
    local inventory = player:FindFirstChild("Inventory") or player:FindFirstChild("Data")
    
    if inventory then
        for _, item in ipairs(inventory:GetDescendants()) do
            if item.Name:lower():find("godly") or (item:IsA("StringValue") and item.Value == "Godly") then
                table.insert(godlys, item)
                if #godlys >= 3 then break end
            end
        end
    end
    return godlys
end

local function startFuse()
    local godlys = getGodlys()
    
    if #godlys < 3 then
        Rayfield:Notify({Title = "Fehler", Content = "Nicht genug Godlys!", Duration = 5})
        return false
    end

    -- 1. Maschine öffnen / Remote feuern
    local fuseRemote = ReplicatedStorage:FindFirstChild("Fuse", true) or ReplicatedStorage:FindFirstChild("Craft", true)
    
    if fuseRemote then
        -- Wir schicken die IDs der 3 Godlys an den Server
        -- Das Format variiert je nach Spiel, meistens eine Table:
        fuseRemote:FireServer("StartFuse", {godlys[1], godlys[2], godlys[3]})
        return true
    end
    return false
end

local function claimFuse()
    local claimRemote = ReplicatedStorage:FindFirstChild("ClaimFuse", true) or ReplicatedStorage:FindFirstChild("Collect", true)
    if claimRemote then
        claimRemote:FireServer()
        return true
    end
    return false
end

-- // UI //
local MainTab = Window:CreateTab("Fuse Farm", 4483362458)

MainTab:CreateToggle({
   Name = "AUTO-FUSE GODLYS",
   CurrentValue = false,
   Callback = function(Value)
      fusing = Value
      
      task.spawn(function()
          while fusing do
              Rayfield:Notify({Title = "Status", Content = "Versuche Fuse zu starten...", Duration = 2})
              
              local success = startFuse()
              
              if success then
                  Rayfield:Notify({Title = "Timer", Content = "Warte 20 Minuten...", Duration = 5})
                  -- Warten: 20 Minuten = 1200 Sekunden
                  -- Wir checken alle 10 Sekunden ob "fusing" noch an ist
                  for i = 1, 120 do
                      if not fusing then break end
                      task.wait(10)
                  end
                  
                  if fusing then
                      claimFuse()
                      Rayfield:Notify({Title = "Erfolg", Content = "Item abgeholt! Neustart...", Duration = 3})
                  end
              else
                  task.wait(30) -- Warten falls keine Godlys da sind
              end
          end
      end)
   end,
})

MainTab:CreateSection("Info")
MainTab:CreateLabel("Script wartet 20 Min nach dem Fuser-Start.")
