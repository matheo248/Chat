--[[
    YOGIMINI VERSION 1.1
    Challenge 3: Seltenheits-Filter & Anti-Base-Hardlock
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.1 | Challenge 3",
   LoadingTitle = "Advanced Rarity System",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "YogiminiConfig",
      FileName = "BrainrotFarm"
   },
   KeySystem = false
})

-- Variablen
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Filter-Einstellungen (Standard alles aus)
local selectedRarities = {
    ["ADMIN"] = false,
    ["ETERNAL"] = false,
    ["OG"] = false,
    ["DIVINE"] = false,
    ["CELESTIAL"] = false,
    ["EXCLUSIVE"] = false,
    ["GODLY"] = false,
    ["SECRET"] = false
}

-- // LOGIK-FUNKTIONEN //

local function getTarget()
    for rarity, enabled in pairs(selectedRarities) do
        if not enabled then continue end
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(obj.Text:upper(), rarity) then
                -- Filter gegen Schilder (Bild 1000053036.jpg)
                if string.find(obj.Text:lower(), "spawn") or string.find(obj.Text:lower(), "in ") then continue end
                
                local model = obj:FindFirstAncestorOfClass("Model")
                if model then
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then
                        -- 1. HARD-RADIUS FIX: Nur in der Mitte der Map (Radius 350 Studs)
                        -- Basen liegen meist bei 500+ Studs Entfernung
                        local distanceFromCenter = (hrp.Position * Vector3.new(1,0,1)).Magnitude
                        if distanceFromCenter > 350 then continue end

                        -- 2. PLAYER CHECK
                        if Players:GetPlayerFromCharacter(model) then continue end
                        
                        -- 3. BASE-NAME CHECK (Zusatzsicherung)
                        local fullName = model:GetFullName():lower()
                        if string.find(fullName, "base") or string.find(fullName, "plot") then continue end

                        return model, hrp
                    end
                end
            end
        end
    end
    return nil
end

-- // UI TABS //

local FarmTab = Window:CreateTab("Farm Settings", 4483362458)

FarmTab:CreateSection("Master Control")
FarmTab:CreateToggle({
   Name = "AUTO-FARM START",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          basePos = player.Character.HumanoidRootPart.CFrame
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 5, 0)
                      task.wait(0.3)
                      
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      if remote and remote:IsA("RemoteEvent") then
                          remote:FireServer(target)
                      end
                      
                      game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                      task.wait(0.1)
                      game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      
                      task.wait(0.2)
                      player.Character.HumanoidRootPart.CFrame = basePos
                  end
                  task.wait(1.2)
              end
          end)
      end
   end,
})

FarmTab:CreateSection("Rarity Selection")

-- Erstelle Toggles für jede Seltenheit
for rarity, _ in pairs(selectedRarities) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value)
          selectedRarities[rarity] = Value
       end,
    })
end

local MiscTab = Window:CreateTab("Misc", 4483362458)
MiscTab:CreateButton({
   Name = "Destroy UI",
   Callback = function() Rayfield:Destroy() end,
})

Rayfield:Notify({
   Title = "Yogimini V1.1",
   Content = "Wähle deine Seltenheiten aus und starte den Farm!",
   Duration = 5
})
