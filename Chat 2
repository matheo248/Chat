local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.2 | Challenge 3",
   LoadingTitle = "Fixed TP & Rarity System",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "YogiminiConfig",
      FileName = "BrainrotFarm"
   },
   KeySystem = false
})

-- Variablen
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Filter-Einstellungen (Secret wurde entfernt)
local selectedRarities = {
    ["ADMIN"] = false,
    ["ETERNAL"] = false,
    ["OG"] = false,
    ["DIVINE"] = false,
    ["CELESTIAL"] = false,
    ["EXCLUSIVE"] = false,
    ["GODLY"] = false
}

-- // VERBESSERTE TARGET-LOGIK //
local function getTarget()
    -- Wir scannen direkt den Workspace für maximale Performance
    for _, model in ipairs(workspace:GetChildren()) do
        -- Wir suchen in jedem Model nach einem TextLabel (Rarity-Tag)
        local label = model:FindFirstChildWhichIsA("TextLabel", true)
        
        if label then
            local labelText = label.Text:upper()
            
            -- Prüfen ob die gefundene Seltenheit aktiviert ist
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    
                    -- Filter gegen Schilder & Spawn-Nachrichten
                    if string.find(labelText:lower(), "spawn") or string.find(labelText:lower(), "in ") then continue end
                    
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then
                        -- BASE-CHECK: Wir prüfen Distanz und Namen
                        local dist = (hrp.Position * Vector3.new(1,0,1)).Magnitude
                        if dist > 400 then continue end -- Alles über 400m ist meistens Base-Bereich
                        
                        if Players:GetPlayerFromCharacter(model) then continue end
                        
                        return model, hrp
                    end
                end
            end
        end
    end
    return nil
end

-- // UI TABS //
local FarmTab = Window:CreateTab("Farm Settings", 4483362458)

FarmTab:CreateSection("Master Control")
FarmTab:CreateToggle({
   Name = "AUTO-FARM START",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          -- Sicheren Standpunkt beim Aktivieren speichern
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
              Rayfield:Notify({Title = "System Aktiv", Content = "Suche nach aktivierten Raritäten...", Duration = 2})
          end

          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  
                  if hrp and farming then
                      -- TELEPORT ENGINE (Verbessert)
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 4, 0)
                      task.wait(0.3)
                      
                      -- COLLECT LOGIK
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      if remote and remote:IsA("RemoteEvent") then
                          remote:FireServer(target)
                      end
                      
                      -- Kurzer E-Druck (Fallback)
                      game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                      task.wait(0.1)
                      game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      
                      task.wait(0.2)
                      -- ESCAPE ZURÜCK ZUR BASE
                      player.Character.HumanoidRootPart.CFrame = basePos
                  end
                  task.wait(1) -- Zeit zwischen den Scans
              end
          end)
      end
   end,
})

FarmTab:CreateSection("Rarity Selection")

-- Toggles für die gewünschten Raritäten (Alphabetisch sortiert)
local rarityList = {"ADMIN", "ETERNAL", "OG", "DIVINE", "CELESTIAL", "EXCLUSIVE", "GODLY"}
for _, rarity in ipairs(rarityList) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value)
          selectedRarities[rarity] = Value
       end,
    })
end

