--[[
    YOGIMINI VERSION 1.5
    Challenge 3 Final Fix: Godly-Pickup & Strict Base-Block
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.5 | Final Fix",
   LoadingTitle = "Safe-Farm System",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- // VERBESSERTER TARGET-SCANNER //
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    
                    -- Filter gegen Shop/Only-Schilder
                    local lowText = obj.Text:lower()
                    if string.find(lowText, "spawn") or string.find(lowText, "only") then continue end
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                        
                        if hrp then
                            -- 1. HARD RADIUS (300 Studs) - Alles andere ist Safe Base-Bereich
                            local dist = (hrp.Position * Vector3.new(1,0,1)).Magnitude
                            if dist > 300 then continue end 
                            
                            -- 2. ANTI-BUTTON & ANTI-SHOP
                            if hrp.Size.Y < 1.3 then continue end
                            if Players:GetPlayerFromCharacter(model) then continue end
                            
                            -- 3. BASE-ELEMENT CHECK
                            local isBase = false
                            for _, part in ipairs(model:GetChildren()) do
                                if part.Name:lower():find("wall") or part.Name:lower():find("floor") then
                                    isBase = true break
                                end
                            end
                            if isBase then continue end

                            return model, hrp, rarity
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          task.spawn(function()
              while farming do
                  local target, hrp, rarityType = getTarget()
                  if hrp and farming then
                      -- 1. TP ZUM ZIEL (Etwas versetzt für Godly)
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
                      task.wait(0.4) -- Zeit zum Laden
                      
                      -- 2. COLLECT LOGIK (Mehrfaches Signal für Godly)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      
                      for i = 1, 3 do -- Wir feuern 3x für maximale Sicherheit
                          if remote then remote:FireServer(target) end
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.05)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      end
                      
                      task.wait(0.2)
                      -- 3. ESCAPE
                      player.Character.HumanoidRootPart.CFrame = basePos
                  end
                  task.wait(1.5) -- Stabilere Pause
              end
          end)
      end
   end,
})

-- Rarity Toggles
for rarity, _ in pairs(selectedRarities) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[rarity] = Value end,
    })
end

Rayfield:Notify({Title = "V1.5 Aktiv", Content = "Strict Base-Block & Godly-Fix geladen.", Duration = 5})
