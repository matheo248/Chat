--[[
    YOGIMINI VERSION 1.7
    Challenge 3: HOLD-LOGIK & BASE-RETURN FIX
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.7 | Hold & Return",
   LoadingTitle = "Improved Pickup Engine",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- // LOGIK: PRÜFEN OB WIR ETWAS IN DER HAND HALTEN //
local function isHoldingAnything()
    local char = player.Character
    if char then
        -- Wir schauen ob ein Tool oder ein Model an den Charakter geschweißt wurde
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or (child:IsA("Model") and child.Name ~= char.Name) then
                return true
            end
        end
    end
    return false
end

local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        -- SICHERHEIT: Kein Spieler, keine Base, kein Knopf
                        if Players:GetPlayerFromCharacter(model) then continue end
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then
                            -- Radius-Check (Sicherheitszone 250m)
                            if (hrp.Position * Vector3.new(1,0,1)).Magnitude > 250 then continue end
                            if hrp.Size.Y < 1.3 then continue end
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- 1. TP ZUM BRAINROT
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
                      task.wait(0.4) -- Zeit zum "Ankommen"
                      
                      -- 2. PICKUP VERSUCH (Mehrfach E drücken)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      local attempts = 0
                      
                      while farming and attempts < 5 and not isHoldingAnything() do
                          if remote then remote:FireServer(target) end
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.1)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                          attempts = attempts + 1
                          task.wait(0.2) -- Kurze Pause zwischen den Versuchen
                      end
                      
                      -- 3. WENN ERFOLGREICH ODER TIMEOUT -> ZURÜCK ZUR BASE
                      task.wait(0.1)
                      player.Character.HumanoidRootPart.CFrame = basePos
                      task.wait(1) -- Warten bis wir sicher in der Base gelandet sind
                  end
                  task.wait(0.5)
              end
          end)
      end
   end,
})

-- Toggles
for rarity, _ in pairs(selectedRarities) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[rarity] = Value end,
    })
end

Rayfield:Notify({Title = "V1.7 Aktiv", Content = "Pickup-Check & Return-Engine bereit.", Duration = 5})
