--[[
    YOGIMINI VERSION 1.9
    BRUTE-FORCE PICKUP & AUTO-RETURN
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.9 | Brute-Force",
   LoadingTitle = "Fixing Pickup...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- FUNKTION: Target finden (Die stabile Version)
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        if Players:GetPlayerFromCharacter(model) then continue end
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then
                            -- Sicherheitscheck gegen Basen
                            if (hrp.Position * Vector3.new(1,0,1)).Magnitude > 300 then continue end
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          -- Speichere die Position beim Starten
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- 1. SCHNELLER TELEPORT
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 2, 0)
                      task.wait(0.3)
                      
                      -- 2. AGGRESSIVES PICKUP (0.8 Sekunden lang E spammen)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      local endTime = tick() + 0.8
                      
                      while tick() < endTime do
                          if remote then remote:FireServer(target) end
                          -- ProximityPrompt direkt feuern für maximale Geschwindigkeit
                          local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                          if prompt then fireproximityprompt(prompt) end
                          
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.05)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                          task.wait(0.05)
                      end
                      
                      -- 3. ZWANGS-TELEPORT ZURÜCK
                      task.wait(0.1)
                      player.Character.HumanoidRootPart.CFrame = basePos
                      task.wait(0.8) -- Kurze Pause in der Base zum Sellen/Ablegen
                  end
                  task.wait(0.2)
              end
          end)
      end
   end,
})

-- Toggles
local list = {"GODLY", "CELESTIAL", "DIVINE", "ADMIN", "EXCLUSIVE", "ETERNAL", "OG"}
for _, r in ipairs(list) do
    FarmTab:CreateToggle({
       Name = "Collect " .. r,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[r] = Value end,
    })
end
