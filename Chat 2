--[[
    YOGIMINI VERSION 2.2
    Challenge 3: E-Press & Instant Base Return
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V2.2 | Final Challenge",
   LoadingTitle = "Executing Farm...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- // TARGET LOGIK (Knopf-Sicher) //
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local text = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(text, rarity) then
                    if string.find(text:lower(), "spawn") or string.find(text:lower(), "only") then continue end
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model and not Players:GetPlayerFromCharacter(model) then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp and hrp.Size.Y > 1.3 and (hrp.Position * Vector3.new(1,0,1)).Magnitude < 250 then
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          -- Position speichern, wo du den Knopf drückst
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- 1. TP ZUM NPC
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2.5)
                      task.wait(0.2)
                      
                      -- 2. "E" DRÜCKEN (INTERAKTION)
                      -- Wir feuern alles gleichzeitig ab für 100% Erfolg
                      local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                      if prompt then
                          fireproximityprompt(prompt)
                      end
                      
                      -- E-Taste hämmern
                      game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                      task.wait(0.1)
                      game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      
                      -- Kurze Verzögerung damit das Item "ankommt"
                      task.wait(0.4)
                      
                      -- 3. SOFORTIGER RÜCKFLUG ZUR BASE
                      if basePos then
                          player.Character.HumanoidRootPart.CFrame = basePos
                      end
                      
                      -- Pause in der Base bevor er das nächste Ziel sucht
                      task.wait(0.8)
                  end
                  task.wait(0.1)
              end
          end)
      end
   end,
})

-- Toggles für die Liste
local list = {"GODLY", "CELESTIAL", "DIVINE", "ADMIN", "EXCLUSIVE", "ETERNAL", "OG"}
for _, r in ipairs(list) do
    FarmTab:CreateToggle({
       Name = "Collect " .. r,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[r] = Value end,
    })
end
