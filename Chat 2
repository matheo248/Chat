--[[
    YOGIMINI VERSION 2.0
    FINAL CHALLENGE 3 FIX: ENGINE-LEVEL TRIGGERING
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V2.0 | Final Fix",
   LoadingTitle = "Engine-Level Farm",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- FUNKTION: Das Ziel finden (Stabilisiert)
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local text = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(text, rarity) then
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model and not Players:GetPlayerFromCharacter(model) then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp and (hrp.Position * Vector3.new(1,0,1)).Magnitude < 300 then
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- 1. PRÄZISER TELEPORT (Direkt vor das ProximityPrompt)
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
                      task.wait(0.25)
                      
                      -- 2. ENGINE-LEVEL INTERACTION (Referenz: RemoteEvent & LocalScript)
                      local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      
                      -- Wir triggern den Prompt direkt in der Engine
                      if prompt then
                          task.spawn(function()
                              fireproximityprompt(prompt) -- Simuliert das Halten von 'E' sofort
                          end)
                      end
                      
                      -- Wir senden das Remote-Signal zur Sicherheit (Referenz: RemoteEvent)
                      if remote and remote:IsA("RemoteEvent") then
                          remote:FireServer(target)
                      end

                      -- Kurzes Warten für die Animation (0.5s sind bei Godly nötig)
                      task.wait(0.5)
                      
                      -- 3. ZWANGS-RÜCKKEHR
                      player.Character.HumanoidRootPart.CFrame = basePos
                      task.wait(0.7) -- Zeit zum Ablegen in der eigenen Base
                  end
                  task.wait(0.1)
              end
          end)
      end
   end,
})

-- Rarity Toggles
local list = {"GODLY", "CELESTIAL", "DIVINE", "ADMIN", "EXCLUSIVE", "ETERNAL", "OG"}
for _, r in ipairs(list) do
    FarmTab:CreateToggle({
       Name = "Collect " .. r,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[r] = Value end,
    })
end
