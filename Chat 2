--[[
    YOGIMINI VERSION 1.4
    Challenge 3: NO-BUTTONS EDITION (Hard-Filter)
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.4 | Anti-Button",
   LoadingTitle = "Filtering Buttons...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false,
    ["ETERNAL"] = false,
    ["OG"] = false,
    ["DIVINE"] = false,
    ["CELESTIAL"] = false,
    ["EXCLUSIVE"] = false,
    ["GODLY"] = false
}

-- // DIE LOGIK DIE KNÖPFE HASST //
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    
                    -- 1. SCHILDER/SHOP FILTER
                    local lowText = obj.Text:lower()
                    if string.find(lowText, "spawn") or string.find(lowText, "only") or string.find(lowText, "in ") then continue end
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
                        
                        if hrp then
                            -- 2. ANTI-KNOPF-CHECK (Sehr wichtig!)
                            -- Die Knöpfe auf deinen Bildern sind meistens flache Teile (Y-Achse sehr klein)
                            -- Echte Brainrot-NPCs sind viel dicker/höher.
                            if hrp.Size.Y < 1.2 then continue end -- Ignoriert flache Platten
                            
                            -- 3. ANTI-BASE CHECK (Radius)
                            local mag = (hrp.Position * Vector3.new(1,0,1)).Magnitude
                            if mag > 450 then continue end 
                            
                            -- 4. KEINE SPIELER
                            if Players:GetPlayerFromCharacter(model) then continue end
                            
                            -- 5. BUTTON-NAMEN FILTER
                            if string.find(model.Name:lower(), "button") or string.find(model.Name:lower(), "pad") then continue end

                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- Teleport 4 Studs drüber
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 4, 0)
                      task.wait(0.3)
                      
                      -- Remote-Signal
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      if remote and remote:IsA("RemoteEvent") then remote:FireServer(target) end
                      
                      -- E-Taste
                      game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                      task.wait(0.1)
                      game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      
                      task.wait(0.2)
                      player.Character.HumanoidRootPart.CFrame = basePos
                  end
                  task.wait(1.2)
              end
          end)
      end
   end,
})

local rarityList = {"ADMIN", "ETERNAL", "OG", "DIVINE", "CELESTIAL", "EXCLUSIVE", "GODLY"}
for _, rarity in ipairs(rarityList) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[rarity] = Value end,
    })
end
