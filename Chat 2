--[[
    YOGIMINI VERSION 1.6
    Challenge 3: ANTI-PLAYER-TP & HARD-RADIUS
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.6 | Anti-Player",
   LoadingTitle = "Humanoid-Filter Active",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- // DER SPIELER-STOPPER //
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        -- 1. SICHERHEIT: Ist es ein echter Spieler? (Character Check)
                        -- Wir prüfen, ob das Modell im "Players" Service existiert
                        if Players:GetPlayerFromCharacter(model) then continue end
                        
                        -- 2. SICHERHEIT: Hat das Modell einen Namen wie ein Spieler?
                        if Players:FindFirstChild(model.Name) then continue end

                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then
                            -- 3. SICHERHEIT: Distanz-Check (Nur öffentliche Zone)
                            -- Alles über 250m ist tabu!
                            local dist = (hrp.Position * Vector3.new(1,0,1)).Magnitude
                            if dist > 250 then continue end 
                            
                            -- 4. SICHERHEIT: Keine Knöpfe/Schilder
                            if hrp.Size.Y < 1.3 then continue end
                            if string.find(obj.Text:lower(), "spawn") then continue end

                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
              basePos = player.Character.HumanoidRootPart.CFrame
          end
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- Blitz-TP
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
                      task.wait(0.35)
                      
                      -- Collect (3x für Godly-Sicherheit)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      for i = 1, 3 do
                          if remote then remote:FireServer(target) end
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.05)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                      end
                      
                      task.wait(0.15)
                      -- Sofort-Rückzug
                      player.Character.HumanoidRootPart.CFrame = basePos
                  end
                  task.wait(1.2)
              end
          end)
      end
   end,
})

-- Toggles
for rarity, _ in pairs(selectedRarities) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[rarity] = Value end,
    })
end

Rayfield:Notify({Title = "V1.6 Geladen", Content = "Spieler-Filter & 250m-Limit aktiv.", Duration = 5})
