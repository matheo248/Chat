--[[
    YOGIMINI VERSION 1.8
    STRICT REPAIR: FIXED TARGETING & HOLD-LOGIC
]]

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "Yogimini V1.8 | Fixed",
   LoadingTitle = "Back to Basics",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = {Enabled = false},
   KeySystem = false
})

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

local selectedRarities = {
    ["ADMIN"] = false, ["ETERNAL"] = false, ["OG"] = false, 
    ["DIVINE"] = false, ["CELESTIAL"] = false, ["EXCLUSIVE"] = false, ["GODLY"] = false
}

-- FUNKTION: Prüfen ob wir das Teil wirklich halten
local function isHoldingBrainrot()
    local char = player.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Model") and v.Name ~= char.Name then return true end
            if v:IsA("Tool") then return true end
        end
    end
    return false
end

-- DIE LOGIK DIE FUNKTIONIERT HAT (V20/V1.5 Mix)
local function getTarget()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local labelText = obj.Text:upper()
            for rarity, enabled in pairs(selectedRarities) do
                if enabled and string.find(labelText, rarity) then
                    
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        -- Hard Filter gegen Spieler und Basen
                        if Players:GetPlayerFromCharacter(model) then continue end
                        
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then
                            -- RADIKALER RADIUS-CHECK (Nur Mitte!)
                            if (hrp.Position * Vector3.new(1,0,1)).Magnitude > 250 then continue end
                            if hrp.Size.Y < 1.3 then continue end -- Keine Bodenplatten
                            
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- // UI //
local FarmTab = Window:CreateTab("Automation", 4483362458)

FarmTab:CreateToggle({
   Name = "START AUTO-FARM",
   CurrentValue = false,
   Flag = "MasterToggle",
   Callback = function(Value)
      farming = Value
      if farming then
          basePos = player.Character.HumanoidRootPart.CFrame
          task.spawn(function()
              while farming do
                  local target, hrp = getTarget()
                  if hrp and farming then
                      -- 1. TELEPORT ZUM NPC
                      player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 3, 0)
                      task.wait(0.4)
                      
                      -- 2. AUFHEBEN (Warten bis es in der Hand ist)
                      local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                      local t = tick()
                      
                      -- Er versucht 2 Sekunden lang zu pickuppen
                      while farming and (tick() - t) < 2 and not isHoldingBrainrot() do
                          if remote then remote:FireServer(target) end
                          game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                          task.wait(0.1)
                          game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                          task.wait(0.2)
                      end
                      
                      -- 3. ZURÜCK ZUR BASE (Nur wenn Zeit um oder Item da)
                      task.wait(0.2)
                      player.Character.HumanoidRootPart.CFrame = basePos
                      task.wait(1)
                  end
                  task.wait(0.5)
              end
          end)
      end
   end,
})

for rarity, _ in pairs(selectedRarities) do
    FarmTab:CreateToggle({
       Name = "Collect " .. rarity,
       CurrentValue = false,
       Callback = function(Value) selectedRarities[rarity] = Value end,
    })
end
