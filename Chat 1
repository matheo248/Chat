local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten nach Priorität (Beste zuerst!)
local priorityList = {"ADMIN", "CELESTIAL", "ETERNAL", "DIVINE", "OG", "EXCLUSIVE", "GODLY", "SECRET"}

local function pressE()
    task.wait(0.2)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.3) -- Etwas länger halten für Sicherheit
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- Sucht das BESTE Brainrot auf der Map
local function findBestBrainrot()
    local allLabels = {}
    
    -- Erstmal alle finden
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            table.insert(allLabels, obj)
        end
    end

    -- Dann die Priorität abfragen
    for _, rarity in ipairs(priorityList) do
        for _, label in ipairs(allLabels) do
            if string.find(string.upper(label.Text), rarity) then
                local model = label:FindFirstAncestorOfClass("Model")
                if model then
                    local isSpawner = string.find(string.lower(model.Name), "spawner") or 
                                      string.find(string.lower(model.Name), "pad")
                    
                    if not isSpawner then
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp then return hrp end
                    end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "YogiminiUltra"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 80)
frame.Position = UDim2.new(0.5, -100, 0.05, 0)
frame.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
Instance.new("UICorner", frame)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(1, -10, 1, -10)
toggle.Position = UDim2.new(0, 5, 0, 5)
toggle.Text = "START GOD-FARM"
toggle.TextScaled = true
toggle.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
toggle.TextColor3 = Color3.new(1,1,1)
Instance.new("UICorner", toggle)

toggle.MouseButton1Click:Connect(function()
    farming = not farming
    toggle.Text = farming and "FARMING..." or "START GOD-FARM"
    toggle.BackgroundColor3 = farming and Color3.fromRGB(150, 0, 0) or Color3.fromRGB(30, 30, 30)

    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if myHrp then
                    if not basePos then basePos = myHrp.Position end

                    local targetHrp = findBestBrainrot()
                    if targetHrp then
                        -- TELEPORT MIT BLICKRICHTUNG
                        -- Wir setzen dich 3 Studs vor das Objekt und lassen dich darauf schauen
                        local offset = targetHrp.CFrame.LookVector * 3
                        myHrp.CFrame = CFrame.new(targetHrp.Position + offset, targetHrp.Position)
                        
                        task.wait(0.4)
                        pressE()
                        task.wait(0.3)
                        
                        -- ZURÜCK
                        myHrp.CFrame = CFrame.new(basePos)
                        task.wait(0.8)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
