local Players = game:GetService("Players")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten
local rarities = {"Admin", "Eternal", "OG", "Divine", "Celestial", "Exclusive", "Godly"}

-- Der "Safe-Check": Ist das Ziel ein echter Brainrot oder nur Deko/Spieler?
local function getSafeTarget()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), string.upper(rarity)) then
                
                -- FILTER 1: Keine Schilder in der Luft (aus Bild 1000053036.jpg)
                local t = string.lower(obj.Text)
                if string.find(t, "spawn") or string.find(t, "in ") then continue end
                
                local model = obj:FindFirstAncestorOfClass("Model")
                if model then
                    -- FILTER 2: Keine anderen Spieler (aus deinem letzten Problem)
                    if Players:GetPlayerFromCharacter(model) then continue end
                    
                    -- FILTER 3: Keine Shop-Knöpfe (aus Bild 1000053018.jpg)
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp and hrp.Size.Y > 1 then
                        -- FILTER 4: Nur Sachen in der Mitte (nicht in fremden Basen)
                        if (hrp.Position - Vector3.new(0,0,0)).Magnitude < 500 then
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 220, 0, 60)
btn.Position = UDim2.new(0.5, -110, 0.2, 0)
btn.Text = "V16: START HYBRID-FARM"
btn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "HYBRID ACTIVE" or "START HYBRID-FARM"
    
    if farming then
        -- Speicher deinen sicheren Standpunkt
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            basePos = player.Character.HumanoidRootPart.CFrame
        end

        task.spawn(function()
            while farming do
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and basePos then
                    local targetModel, targetHrp = getSafeTarget()
                    
                    if targetHrp then
                        -- Blitz-Teleport zum Ziel
                        hrp.CFrame = targetHrp.CFrame
                        task.wait(0.2)
                        
                        -- Nutze die Collect-Funktion
                        game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(0.1)
                        game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        
                        -- Sofortiger Rückzug (Escape)
                        task.wait(0.1)
                        hrp.CFrame = basePos
                    end
                end
                task.wait(1)
            end
        end)
    end
end)
