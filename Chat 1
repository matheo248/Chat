--// YOGIMINI V18: THE FINAL BARRIER (ANTI-ROBUX & AREA-LOCK)

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten (Priorität)
local rarities = {"Admin", "Eternal", "OG", "Divine", "Celestial", "Exclusive", "Godly"}

-- SICHERHEITS-FUNKTION: Prüft auf Kauf-Fenster
local function isPurchaseWindowOpen()
    if MarketplaceService:GetProductInfo(1, Enum.InfoType.Product) then -- Checkt die Engine auf Kauf-Anfragen
        return true
    end
    return false
end

-- FUNKTION: Prüft ob das Ziel in einer verbotenen Kauf-Zone liegt
local function isInShopArea(targetPos)
    -- Die Shop-Platten und Kauf-NPCs stehen fast immer an festen Koordinaten am Spawn
    -- Wir messen die Distanz zum Zentrum des Spawns (0, 10, 0 ist oft der Standard-Spawn)
    local spawnCenter = Vector3.new(0, 0, 0) 
    local distToSpawn = (targetPos * Vector3.new(1,0,1) - spawnCenter).Magnitude
    
    -- Wenn das Ziel näher als 150 Meter am Spawn ist, ist es vermutlich ein Shop-NPC
    if distToSpawn < 150 then
        return true
    end
    return false
end

local function getValidTarget()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), string.upper(rarity)) then
                
                -- Filter gegen Schilder (Bild 1000053036.jpg)
                local t = string.lower(obj.Text)
                if string.find(t, "spawn") or string.find(t, "in ") then continue end
                
                local model = obj:FindFirstAncestorOfClass("Model")
                if model then
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then
                        -- 1. ZONE-CHECK: Ist es im Shop-Bereich?
                        if isInShopArea(hrp.Position) then continue end

                        -- 2. ROBUX-ICON-CHECK: Hat das Modell ein Kauf-Bild?
                        local hasRobuxIcon = false
                        for _, d in ipairs(model:GetDescendants()) do
                            if d:IsA("ImageLabel") and string.find(string.lower(d.Image), "rbx") then
                                hasRobuxIcon = true
                                break
                            end
                        end
                        if hasRobuxIcon then continue end

                        -- 3. PLAYER-CHECK: Gehört es einem Spieler?
                        if Players:GetPlayerFromCharacter(model) then continue end

                        return model, hrp
                    end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "YogiminiV18"
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 250, 0, 60)
btn.Position = UDim2.new(0.5, -125, 0.05, 0)
btn.Text = "V18: ANTI-ROBUX FARM"
btn.BackgroundColor3 = Color3.fromRGB(200, 0, 0) -- Rot für Alarm-Bereitschaft
btn.TextColor3 = Color3.new(1,1,1)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "PROTECTED FARMING..." or "V18: START SAFE FARM"
    btn.BackgroundColor3 = farming and Color3.fromRGB(50, 50, 50) or Color3.fromRGB(200, 0, 0)

    if farming then
        -- Setze BasePos weit weg vom Shop!
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            basePos = player.Character.HumanoidRootPart.CFrame
        end

        task.spawn(function()
            while farming do
                -- STOPP, wenn ein Kauf-Fenster erscheint!
                if isPurchaseWindowOpen() then 
                    farming = false 
                    btn.Text = "STOPPED: ROBUX RISK!"
                    break 
                end

                local targetModel, targetHrp = getValidTarget()
                if targetHrp and farming then
                    -- Teleport
                    player.Character.HumanoidRootPart.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 2)
                    task.wait(0.3)
                    
                    -- Interagieren
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.1)
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    
                    -- Escape
                    task.wait(0.2)
                    player.Character.HumanoidRootPart.CFrame = basePos
                end
                task.wait(1.2)
            end
        end)
    end
end)
