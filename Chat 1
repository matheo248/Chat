--// YOGIMINI BRAINROT REPAIR-V4 (TEXT-DETECTION EDITION)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten, nach denen wir im TEXT suchen
local targetRarities = {"EXCLUSIVE", "GODLY", "DIVINE", "OG", "ETERNAL", "CELESTIAL", "ADMIN", "SECRET"}

-- Funktion zum Interagieren (E drücken)
local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.15)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- Die neue schlaue Suchfunktion
local function findCorrectBrainrot()
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Wir suchen nach TextLabels (die den Namen/Seltenheit anzeigen)
        if obj:IsA("TextLabel") then
            local text = string.upper(obj.Text)
            
            for _, rarity in ipairs(targetRarities) do
                if string.find(text, rarity) then
                    -- Wir haben den Text gefunden! Jetzt holen wir uns das dazugehörige Teil.
                    local targetPart = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorWhichIsA("Model")
                    
                    if targetPart then
                        -- Sicherheits-Check: Ist es weit genug weg vom Spawn/Shop?
                        -- (Die Shop-Knöpfe sind meistens an einer festen Stelle)
                        local distFromBase = basePos and (targetPart:GetPivot().Position - basePos).Magnitude or 100
                        
                        if distFromBase > 15 then 
                            return targetPart
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "YogiminiFinalBoss"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 80)
frame.Position = UDim2.new(0.5, -100, 0.05, 0)
frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
frame.BackgroundTransparency = 0.3
Instance.new("UICorner", frame)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(0, 180, 0, 60)
toggle.Position = UDim2.new(0.5, -90, 0.5, -30)
toggle.Text = "START BRAINROT FARM"
toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 150)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.TextScaled = true
Instance.new("UICorner", toggle)

-- FARMING SCHLEIFE
toggle.MouseButton1Click:Connect(function()
    farming = not farming
    toggle.Text = farming and "STOP" or "START BRAINROT"
    
    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    if not basePos then basePos = hrp.Position end

                    local target = findCorrectBrainrot()
                    if target then
                        -- Teleport zum Brainrot (nutzt Pivot für Models)
                        local targetPos = target:GetPivot().Position
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                        
                        task.wait(0.4)
                        pressE()
                        task.wait(0.2)
                        
                        -- Sofort zurück nach Hause
                        hrp.CFrame = CFrame.new(basePos)
                        task.wait(0.8)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
