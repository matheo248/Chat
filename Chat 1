-- FUNKTION: Das 'Steal' Event finden und feuern (Referenz: RemoteEvent Klasse)
local function remoteSteal(targetModel)
    -- Wir suchen nach dem Event, das den 'Steal' Befehl an den Server sendet
    -- Viele Spiele verstecken es in ReplicatedStorage unter 'Remotes' oder 'Events'
    local remote = ReplicatedStorage:FindFirstChild("Steal", true) or 
                   ReplicatedStorage:FindFirstChild("Collect", true) or
                   ReplicatedStorage:FindFirstChild("Pickup", true)

    if remote and remote:IsA("RemoteEvent") then
        -- Wir senden das Signal direkt an den Server
        remote:FireServer(targetModel)
    end
end

-- Der ultimative Filter: Nur echte NPCs, keine Kauf-Platten
local function getRealBrainrot()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), string.upper(rarity)) then
                
                -- Filter gegen Schilder in der Luft (1000053036.jpg)
                if string.find(obj.Text:lower(), "spawn") then continue end
                
                local model = obj:FindFirstAncestorOfClass("Model")
                if model then
                    -- FILTER: Wenn das Modell ein 'Purchase' oder 'Robux' Tag hat, ignorieren
                    if model:FindFirstChild("Price") or model:FindFirstChild("Currency") then continue end
                    
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then
                        -- Check: Nur NPCs die auf dem Boden stehen (keine Shop-Anzeigen)
                        -- Echte Brainrots sind meistens hinter Gittern (Foto 1000053040.jpg)
                        if hrp.Position.Y < 40 and hrp.Size.Y > 1.5 then
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

