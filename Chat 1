--// YOGIMINI V12: ULTIMATE AUTO-COLLECT & ESCAPE

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten (Beste zuerst)
local rarities = {"ADMIN", "CELESTIAL", "ETERNAL", "DIVINE", "OG", "EXCLUSIVE", "GODLY", "SECRET"}

-- Funktion: Das Brainrot wirklich EINSAMMELN (Remote Trigger)
local function collect(targetModel)
    -- Wir versuchen das RemoteEvent zu finden, das das Raw-Script nutzt
    local event = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Collect") 
                  or ReplicatedStorage:FindFirstChild("Pickup")
    
    if event then
        event:FireServer(targetModel)
    end
    
    -- Fallback: Simuliere ProximityPrompt (für alle Fälle)
    local prompt = targetModel:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt)
    end
end

-- Filter: Nur echte Brainrots (keine Schilder/Shop-Platten)
local function isValidBrainrot(obj)
    local text = string.lower(obj.Text)
    -- Filter Schilder (Bild 1000053036/1000053040)
    if string.find(text, "spawn") or string.find(text, "in") or string.find(text, "time") then return false end
    
    local model = obj:FindFirstAncestorOfClass("Model")
    if model then
        -- Filter Shop-Platten
        if model:FindFirstChild("ImageLabel", true) and string.find(string.lower(model:FindFirstChild("ImageLabel", true).Image), "rbx") then return false end
        
        -- Muss ein NPC/Objekt am Boden sein
        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
        if hrp and hrp.Position.Y < 50 then
            return model, hrp
        end
    end
    return nil
end

-- Suche das beste Ziel
local function getBestTarget()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), rarity) then
                local model, hrp = isValidBrainrot(obj)
                if model then return model, hrp end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0, 20)
btn.Text = "ACTIVATE GOD-FARM"
btn.BackgroundColor3 = Color3.fromRGB(0, 255, 150)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "FARMING ON" or "ACTIVATE GOD-FARM"
    btn.BackgroundColor3 = farming and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(0, 255, 150)
    
    if farming then
        -- Setze Flucht-Punkt (Base)
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            basePos = char.HumanoidRootPart.CFrame
        end

        task.spawn(function()
            while farming do
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if myHrp and basePos then
                    local targetModel, targetHrp = getBestTarget()
                    if targetHrp then
                        -- 1. TELEPORT ZUM TARGET
                        myHrp.CFrame = targetHrp.CFrame
                        task.wait(0.2)
                        
                        -- 2. AUTO COLLECT
                        collect(targetModel)
                        task.wait(0.1)
                        
                        -- 3. AUTO ESCAPE (Sofort zurück zur Base)
                        myHrp.CFrame = basePos
                        task.wait(0.5)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
