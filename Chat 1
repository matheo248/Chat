--// YOGIMINI BRAINROT V8 (ENGINE-EXPLOIT EDITION)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Priorität (Beste zuerst)
local priority = {"ADMIN", "CELESTIAL", "ETERNAL", "DIVINE", "OG", "EXCLUSIVE", "GODLY", "SECRET"}

-- Funktion: Versucht das Brainrot mit ALLEN Mitteln aufzusammeln
local function megaInteract(target)
    -- 1. Versuch: ProximityPrompt (Engine Standard)
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt)
    end
    
    -- 2. Versuch: ClickDetector (Alter Engine Standard)
    local cd = target:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then
        fireclickdetector(cd)
    end

    -- 3. Versuch: "E" Taste physisch hämmern
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    
    -- 4. Versuch: RemoteEvents im ReplicatedStorage triggern (Blind-Versuch)
    -- Viele Spiele nutzen Events namens "Pickup" oder "Collect"
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") and (string.find(child.Name, "Collect") or string.find(child.Name, "Pickup")) then
            child:FireServer(target)
        end
    end
end

-- Funktion: Findet das Ziel (Workspace-Klasse optimiert)
local function getTarget()
    for _, rarity in ipairs(priority) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), rarity) then
                local model = obj:FindFirstAncestorOfClass("Model")
                if model and not string.find(string.lower(model.Name), "spawner") then
                    -- Wir nehmen das RootPart oder das erste Part im Model
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChildWhichIsA("BasePart", true)
                    if hrp then return model, hrp end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "YogiminiElite"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 80)
frame.Position = UDim2.new(0.5, -100, 0.02, 0)
frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Instance.new("UICorner", frame)

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, -10, 1, -10)
btn.Position = UDim2.new(0, 5, 0, 5)
btn.Text = "START ELITE FARM"
btn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "RUNNING..." or "START ELITE FARM"
    
    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if myHrp then
                    if not basePos then basePos = myHrp.Position end

                    local targetModel, targetHrp = getTarget()
                    if targetHrp then
                        -- Teleport: Direkt INS Brainrot hinein (manchmal braucht man Kontakt)
                        myHrp.CFrame = targetHrp.CFrame
                        
                        task.wait(0.3)
                        megaInteract(targetModel)
                        task.wait(0.2)
                        
                        -- Zurück
                        myHrp.CFrame = CFrame.new(basePos)
                        task.wait(0.5)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
