--// YOGIMINI V20: GHOST-RAY & BASE-EXCLUSION

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Diese Seltenheiten suchen wir
local rarities = {"Admin", "Eternal", "OG", "Divine", "Celestial", "Exclusive", "Godly"}

-- FUNKTION: Prüft physisch, ob ein Punkt in einer Spieler-Base liegt
local function isInsideAnyPlayerBase(position)
    -- Wir suchen nach Objekten mit Namen "Base", "Plot" oder "Owner" in der Nähe
    local checkRadius = 15 -- Wie groß ist eine typische Base-Zone?
    local parts = workspace:FindPartsInRegion3(Region3.new(position - Vector3.new(checkRadius, 10, checkRadius), position + Vector3.new(checkRadius, 20, checkRadius)), nil, 100)
    
    for _, part in ipairs(parts) do
        local name = part.Name:lower()
        local parentName = part.Parent.Name:lower()
        if string.find(name, "base") or string.find(name, "plot") or string.find(parentName, "base") or string.find(parentName, "plot") then
            return true -- Es ist in einer Base!
        end
    end
    return false
end

local function getTarget()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(obj.Text:upper(), rarity:upper()) then
                
                -- FILTER 1: Schilder-Check (Bild 1000053036.jpg)
                if string.find(obj.Text:lower(), "spawn") or string.find(obj.Text:lower(), "in ") then continue end
                
                local model = obj:FindFirstAncestorOfClass("Model")
                if model then
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then
                        -- FILTER 2: Physikalische Base-Abfrage
                        -- Wenn der Punkt in einer Zone liegt, die als "Base" markiert ist -> IGNORIEREN
                        if isInsideAnyPlayerBase(hrp.Position) then continue end
                        
                        -- FILTER 3: Kein echter Spieler
                        if Players:GetPlayerFromCharacter(model) then continue end

                        -- FILTER 4: Shop-Knopf Filter (Größe)
                        if hrp.Size.Y < 1.5 then continue end

                        return model, hrp
                    end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.Name = "YogiminiV20"
gui.ResetOnSpawn = false

local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 250, 0, 60)
btn.Position = UDim2.new(0.5, -125, 0.1, 0)
btn.Text = "V20: GHOST-MODE (NO BASES)"
btn.BackgroundColor3 = Color3.fromRGB(100, 0, 255)
btn.TextColor3 = Color3.new(1,1,1)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "GHOST FARMING..." or "START V20"
    btn.BackgroundColor3 = farming and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(100, 0, 255)

    if farming then
        basePos = player.Character.HumanoidRootPart.CFrame
        
        task.spawn(function()
            while farming do
                local target, hrp = getTarget()
                
                if hrp and farming then
                    -- TELEPORT: Wir landen 5 Studs ÜBER dem Ziel (Sicherheitsabstand zu Kauf-Triggern)
                    player.Character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 5, 0)
                    task.wait(0.3)
                    
                    -- REMOTE-STEAL (Direktes Signal nutzen)
                    local remote = ReplicatedStorage:FindFirstChild("Steal", true) or ReplicatedStorage:FindFirstChild("Collect", true)
                    if remote and remote:IsA("RemoteEvent") then
                        remote:FireServer(target)
                    end
                    
                    -- FALLBACK: E-Taste nur ganz kurz
                    game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.05)
                    game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                    
                    task.wait(0.2)
                    player.Character.HumanoidRootPart.CFrame = basePos
                end
                task.wait(1.5)
            end
        end)
    end
end)
