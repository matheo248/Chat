--// YOGIMINI BRAINROT REPAIR-V5 (THE NPC-DETECTOR)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten (Großbuchstaben für den Text-Check)
local targetRarities = {"EXCLUSIVE", "GODLY", "DIVINE", "OG", "ETERNAL", "CELESTIAL", "ADMIN", "SECRET"}

-- Funktion zum E-Drücken
local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.2)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- Die INTELLIGENTE Suchfunktion
local function findActualBrainrot()
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- 1. Wir suchen nach dem TextLabel (wie auf dem Foto)
        if obj:IsA("TextLabel") then
            local text = string.upper(obj.Text)
            
            for _, rarity in ipairs(targetRarities) do
                if string.find(text, rarity) then
                    
                    -- 2. Wir haben den Text gefunden. Jetzt suchen wir das Model dazu.
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        -- 3. DER ENTSCHEIDENDE CHECK:
                        -- Ein Spawner hat keinen "Humanoid". Ein Brainrot (NPC) schon!
                        -- Oder wir prüfen, ob der Name des Models "Spawner" enthält.
                        local isSpawner = string.find(string.lower(model.Name), "spawner") or 
                                          string.find(string.lower(model.Name), "pad") or
                                          string.find(string.lower(model.Name), "button")

                        if not isSpawner then
                            -- Wenn es ein Model mit einem RootPart ist, ist es unser Brainrot
                            local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                            if hrp then
                                return hrp
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- GUI (Cleaner Look)
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "YogiminiGodMode"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 220, 0, 90)
frame.Position = UDim2.new(0.5, -110, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.Active = true
frame.Draggable = true -- Damit du es auf dem Handy verschieben kannst
Instance.new("UICorner", frame)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(0, 200, 0, 70)
toggle.Position = UDim2.new(0, 10, 0, 10)
toggle.Text = "START FARM"
toggle.BackgroundColor3 = Color3.fromRGB(85, 0, 255)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.TextScaled = true
Instance.new("UICorner", toggle)

-- FARMING LOOP
toggle.MouseButton1Click:Connect(function()
    farming = not farming
    toggle.Text = farming and "STOPPING..." or "START FARM"
    toggle.BackgroundColor3 = farming and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(85, 0, 255)
    
    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if myHrp then
                    if not basePos then basePos = myHrp.Position end

                    local targetHrp = findActualBrainrot()
                    if targetHrp then
                        toggle.Text = "FARMING..."
                        
                        -- Teleportiere zum Brainrot NPC
                        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 3) -- 3 Studs davor landen
                        
                        task.wait(0.5)
                        pressE()
                        task.wait(0.3)
                        
                        -- Zurück zur Base
                        myHrp.CFrame = CFrame.new(basePos)
                        task.wait(0.7)
                    else
                        toggle.Text = "WAITING FOR SPAWN..."
                    end
                end
                task.wait(0.5)
            end
            toggle.Text = "START FARM"
        end)
    end
end)
