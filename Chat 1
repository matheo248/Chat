task.spawn(function()

    local busy = false

    while farming do

        for _,pos in ipairs(brainrots) do

            if not farming then break end

            if busy then continue end
            busy = true

            -- teleport slightly above to avoid ground desync
            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))

            task.wait(0.15) -- fast stabilize

            -- instant E press
            pressE()

            -- NO LONG WAIT HERE
            task.wait(0.1)

            -- instant return
            hrp.CFrame = CFrame.new(basePos)

            task.wait(0.25) -- tiny buffer only

            busy = false
        end
    end
end)
