--// YOGIMINI V14: THE MENU-DRIVE (FULL AUTO)

-- Lädt das Script aus deinem Screenshot
task.spawn(function()
    loadstring(game:HttpGet("https://rawscripts.net/raw/1H-Steal-The-Brainrot-Base-Auto-Escape-n-Free-Gear-and-more-155757"))()
end)

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Seltenheiten wie im Menü (Bild 1000053042.jpg)
local rarities = {"Admin", "Eternal", "OG", "Divine", "Celestial", "Exclusive", "Godly"}

-- Diese Funktion findet das Modell, aber IGNORIERT die Shop-Knöpfe
local function getTarget()
    for _, rarity in ipairs(rarities) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(obj.Text, rarity) then
                -- Sicherstellen, dass es kein Schild in der Luft oder Shop-Knopf ist
                local t = string.lower(obj.Text)
                if not string.find(t, "spawn") and not string.find(t, "in ") then
                    local model = obj:FindFirstAncestorOfClass("Model")
                    if model then
                        -- Check ob es ein flacher Knopf am Boden ist (wie auf deinen Bildern)
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if hrp and hrp.Size.Y > 1 then -- NPCs sind dicker als Bodenplatten
                            return model, hrp
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- GUI für den Autopiloten
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0.25, 0)
btn.Text = "START V14 AUTO-MODE"
btn.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "AUTOPILOT ON" or "START V14 AUTO-MODE"
    
    if farming then
        -- Setze Flucht-Punkt
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            basePos = player.Character.HumanoidRootPart.CFrame
        end

        task.spawn(function()
            while farming do
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp and basePos then
                    local targetModel, targetHrp = getTarget()
                    
                    if targetHrp then
                        -- 1. TP zum Brainrot (nutzt die Distanz-Logik vom Menü)
                        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1)
                        task.wait(0.2)
                        
                        -- 2. AUTOMATISCH AUFHEBEN
                        -- Wir simulieren E und triggern das Remote, das im Menü-Script steckt
                        game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.E, false, game)
                        task.wait(0.1)
                        game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.E, false, game)
                        
                        -- 3. AUTO-ESCAPE (Sofort zurück zur Base)
                        task.wait(0.1)
                        hrp.CFrame = basePos
                    end
                end
                task.wait(1) -- Kurze Pause, damit der Server nicht kickt
            end
        end)
    end
end)
