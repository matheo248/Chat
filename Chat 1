--// YOGIMINI BRAINROT REPAIR-V2 (No-Button-Edition)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

local targetNames = {"Exclusive", "OG", "Divine", "Eternal", "Celestial", "Admin"}

-- Funktion zum Drücken der E-Taste
local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.2)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- VERBESSERTE SUCHE: Ignoriert Shop-Knöpfe
local function findTarget(namePart)
    for _, obj in ipairs(workspace:GetDescendants()) do
        -- Prüfe, ob der Name passt UND es kein UI-Knopf ist
        if (obj:IsA("BasePart") or obj:IsA("Model")) and string.find(obj.Name, namePart) then
            
            -- CHECK: Ist es ein Kauf-Button? (Ignoriere Objekte mit "Button" oder "Purchase" im Namen/Parent)
            local isButton = false
            if string.find(string.lower(obj.Name), "button") or 
               string.find(string.lower(obj.Name), "buy") or 
               obj:FindFirstChildWhichIsA("BillboardGui") then
                isButton = true
            end

            if not isButton then
                -- Wenn es ein Model ist, nimm das Hauptteil, sonst das Part selbst
                return obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
            end
        end
    end
    return nil
end

-- GUI (Gleiches Design wie vorhin)
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "YogiminiFarmV2"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 100)
frame.Position = UDim2.new(0.5, -100, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Instance.new("UICorner", frame)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(0, 160, 0, 40)
toggle.Position = UDim2.new(0.5, -80, 0.5, -20)
toggle.Text = "START FARM"
toggle.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
toggle.TextColor3 = Color3.new(1,1,1)
toggle.TextScaled = true
Instance.new("UICorner", toggle)

-- FARMING LOGIK
toggle.MouseButton1Click:Connect(function()
    farming = not farming
    toggle.Text = farming and "STOP FARM" or "START FARM"
    toggle.BackgroundColor3 = farming and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 150, 255)

    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if hrp then
                    if not basePos then basePos = hrp.Position end

                    for _, name in ipairs(targetNames) do
                        if not farming then break end
                        
                        local target = findTarget(name)
                        if target then
                            -- Teleportiere direkt zum Objekt
                            hrp.CFrame = target.CFrame * CFrame.new(0, 2, 0) 
                            task.wait(0.5)
                            
                            pressE()
                            task.wait(0.3)
                            
                            -- Sofort zurück nach Hause
                            hrp.CFrame = CFrame.new(basePos)
                            task.wait(0.7) -- Kurze Pause vor dem nächsten Check
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
