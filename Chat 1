--// YOGIMINI BRAINROT V7 (CORE-LEVEL DETECTION)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local CollectionService = game:GetService("CollectionService")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Priorität (Beste zuerst)
local priority = {"ADMIN", "CELESTIAL", "ETERNAL", "DIVINE", "OG", "EXCLUSIVE", "GODLY", "SECRET"}

-- Funktion: Löst die Interaktion aus
local function interact(model)
    -- Suche nach einem ProximityPrompt (der Standard-Weg in Roblox Core)
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt) -- Das ist der "Cheat-Code", um E sofort auszulösen
    else
        -- Manueller Fallback
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.2)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

-- Funktion: Findet das Objekt über Text oder interne Tags
local function getTarget()
    -- 1. Check nach Seltenheit in TextLabels
    for _, rarity in ipairs(priority) do
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") and string.find(string.upper(obj.Text), rarity) then
                local model = obj:FindFirstAncestorOfClass("Model")
                if model and not string.find(string.lower(model.Name), "spawner") then
                    local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                    if hrp then return model, hrp end
                end
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.Name = "YogiminiCore"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 200, 0, 80)
frame.Position = UDim2.new(0.5, -100, 0.1, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Instance.new("UICorner", frame)

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, -10, 1, -10)
btn.Position = UDim2.new(0, 5, 0, 5)
btn.Text = "ACTIVATE CORE FARM"
btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
btn.TextColor3 = Color3.new(1,1,1)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "FARMING..." or "ACTIVATE CORE FARM"
    btn.BackgroundColor3 = farming and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(0, 120, 255)

    if farming then
        task.spawn(function()
            while farming do
                local char = player.Character
                local myHrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if myHrp then
                    if not basePos then basePos = myHrp.Position end

                    local targetModel, targetHrp = getTarget()
                    if targetHrp then
                        -- Teleport: Direkt davor schauen
                        myHrp.CFrame = CFrame.new(targetHrp.Position + (targetHrp.CFrame.LookVector * 2.5), targetHrp.Position)
                        
                        task.wait(0.3)
                        interact(targetModel)
                        task.wait(0.3)
                        
                        -- Schnell zurück
                        myHrp.CFrame = CFrame.new(basePos)
                        task.wait(0.5)
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)
