--// YOGIMINI V10: THE SHOP-BREAKER (FINAL)

local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local farming = false
local basePos = nil

-- Priorität der Seltenheiten
local priority = {"ADMIN", "CELESTIAL", "ETERNAL", "DIVINE", "OG", "EXCLUSIVE", "GODLY", "SECRET"}

-- Funktion: Hard-Interaktion
local function interact(target)
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt)
    else
        -- Wir drücken E mehrfach, um sicherzugehen
        for i = 1, 3 do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
    end
end

-- Der ultimative Shop-Platten-Killer
local function isActuallyABrainrot(obj)
    local model = obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model")
    if not model then return false end

    -- 1. DISTANZ-CHECK (Der wichtigste Part!)
    -- Wenn das Teil zu nah am Startpunkt ist, ist es IMMER ein Shop-Knopf.
    if basePos then
        local dist = (model:GetPivot().Position - basePos).Magnitude
        if dist < 40 then return false end -- Shop-Platten sind meistens nah beieinander am Spawn
    end

    -- 2. ROBUX-CHECK (Extrem sensibel)
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ImageLabel") and (string.find(child.Image, "rbx") or string.find(child.Image, "9430635442")) then
            return false -- Das ist ein Kauf-Icon!
        end
        if child:IsA("TextLabel") and (string.find(child.Text, "R%$") or string.find(child.Text, "299") or string.find(child.Text, "599")) then
            return false -- Das ist ein Preis!
        end
    end

    -- 3. FORM-CHECK
    -- Shop-Platten haben oft keinen "Humanoid". Echte Brainrots oft schon.
    if not model:FindFirstChildOfClass("Humanoid") and not model:FindFirstChild("HumanoidRootPart") then
        -- Wenn es nur ein flacher Klotz ist, ignorieren wir es
        local box = model:FindFirstChildWhichIsA("BasePart")
        if box and box.Size.Y < 1.5 then return false end
    end

    return true
end

local function findTheRealOne()
    local potentialTargets = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local t = string.upper(obj.Text)
            for _, pName in ipairs(priority) do
                if string.find(t, pName) then
                    if isActuallyABrainrot(obj) then
                        table.insert(potentialTargets, {model = obj:FindFirstAncestorOfClass("Model") or obj.Parent, prio = pName})
                    end
                end
            end
        end
    end

    -- Sortiere nach deiner Prioritäts-Liste
    for _, pName in ipairs(priority) do
        for _, entry in ipairs(potentialTargets) do
            if entry.prio == pName then
                return entry.model
            end
        end
    end
    return nil
end

-- GUI
local gui = Instance.new("ScreenGui", player.PlayerGui)
gui.ResetOnSpawn = false
local btn = Instance.new("TextButton", gui)
btn.Size = UDim2.new(0, 200, 0, 50)
btn.Position = UDim2.new(0.5, -100, 0.05, 0)
btn.Text = "V10: KILL SHOP BUTTONS"
btn.BackgroundColor3 = Color3.fromRGB(255, 0, 100)
btn.TextColor3 = Color3.new(1,1,1)
btn.TextScaled = true
Instance.new("UICorner", btn)

btn.MouseButton1Click:Connect(function()
    farming = not farming
    btn.Text = farming and "FARMING..." or "START V10"
    
    if farming then
        -- Setze BasePos beim ALLERERSTEN Klick (Stell dich weit weg vom Shop auf!)
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            basePos = char.HumanoidRootPart.Position
        end

        task.spawn(function()
            while farming do
                local myChar = player.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                
                if myHrp then
                    local target = findTheRealOne()
                    if target then
                        local targetPos = target:GetPivot().Position
                        myHrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
                        task.wait(0.4)
                        interact(target)
                        task.wait(0.2)
                        myHrp.CFrame = CFrame.new(basePos)
                    end
                end
                task.wait(1)
            end
        end)
    end
end)
